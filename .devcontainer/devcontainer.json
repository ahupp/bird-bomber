{
  "name": "Bird Bomber",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.live-server"
      ]
    }
  },
  "forwardPorts": [
    3000,
    3001
  ],
  "portsAttributes": {
    "3000": {
      "label": "Play Bird Bomber",
      "onAutoForward": "openPreview"
    },
    "3001": {
      "label": "Live Preview reload",
      "onAutoForward": "silent"
    }
  }
}
